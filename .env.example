# Encrypts per-user MuAPI keys at rest (AES-256-GCM). Min 32 chars.
# Generate with: openssl rand -base64 32
# Changing it makes already-stored keys undecryptable (users must re-enter them).
MUAPI_KEY_ENCRYPTION_SECRET="replace-with-output-of-openssl-rand-base64-32"

# Feature Flags
NEXT_PUBLIC_USE_DYNAMIC_MODELS="true"
