# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ── Image provider (OpenAI-compatible, e.g. apinet.cloud) ────────────────────
# Powers Image Studio. The /api/images proxy calls {IMAGE_API_BASE}/images/generations.
IMAGE_API_BASE=https://apinet.cloud/v1
IMAGE_API_KEY=

# ── Backend API (legacy MuAPI — agents/workflows/video) ──────────────────────
# Base URL of the generative API the app proxies to. Defaults to MuAPI if unset.
# Used by the /api/v1, /app, /workflow, /agents proxy routes.
API_BASE=https://api.muapi.ai

# Same base URL, exposed to the browser build. Only needed for non-http contexts
# (e.g. the Electron file:// renderer) where requests can't go through the proxy.
NEXT_PUBLIC_API_BASE=https://api.muapi.ai

# ── Auth key ─────────────────────────────────────────────────────────────────
# API key used by server-side code (API route handlers).
MUAPI_KEY=

# API key exposed to the browser build. Only set if the client must call the API directly.
NEXT_PUBLIC_MUAPI_KEY=
